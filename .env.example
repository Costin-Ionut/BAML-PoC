# Copy this file to .env and fill in the values.

# LLM server.
HOST=http://<server>:<port>/v1
API_KEY=
MODEL=

# Boundary Studio (traces). Create a project at https://studio.boundaryml.com/ and copy its API key.
# Optional: without it nothing is sent to Boundary Studio.
BOUNDARY_API_KEY=

# Port of this API. Optional: defaults to 8000.
PORT=8000
